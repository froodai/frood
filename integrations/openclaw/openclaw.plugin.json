{
  "id": "frood",
  "name": "Memory (Frood)",
  "description": "Frood as OpenClaw's memory: before each turn, what Frood knows about the message, with sources and a 'not verified' mark where no person has checked it; memory_search, memory_get and memory_add over Frood.",
  "version": "0.1.12",
  "kind": "memory",
  "categories": ["memory"],
  "contracts": {
    "tools": ["memory_search", "memory_get", "memory_add"]
  },
  "uiHints": {
    "url": { "label": "Frood's address", "placeholder": "http://127.0.0.1:8080" },
    "token": { "label": "Frood token (read, capture, propose)", "sensitive": true }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": { "type": "string", "default": "http://127.0.0.1:8080" },
      "token": { "type": "string", "sensitive": true },
      "recall": { "type": "boolean", "default": true },
      "recallLimit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 6 }
    },
    "required": ["token"]
  }
}
